# 复制为 .env 后按需修改。**不要**把真实凭据提交进版本库。
#
# 完整配置项与默认值见 docs/06-§7 配置项全表。

APP_ENV=local
HTTP_ADDR=0.0.0.0:8080
API_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_FORMAT=json

# ⚠️ 必须带 parseTime=True&loc=UTC
MYSQL_DSN=root:CHANGE_ME@tcp(127.0.0.1:3306)/ai_platform?charset=utf8mb4&parseTime=True&loc=UTC
REDIS_URL=redis://127.0.0.1:6379/1

# 生产环境必填（≥ 32 字节）；留空时服务在 prod 下拒绝启动。
JWT_SECRET=
INTERNAL_SERVICE_TOKEN=

AI_PLATFORM_BASE_URL=http://127.0.0.1:8000
AI_GRPC_ENABLED=false
AI_PLATFORM_GRPC_TARGET=127.0.0.1:50051

OTEL_ENABLED=false
