# ============================================================
# ai-platform 环境变量模板
#   Copy-Item .env.example .env  然后按需修改
#   密钥类（OPENAI_API_KEY / JWT_SECRET / MINIO_SECRET_KEY / MILVUS_TOKEN /
#   API_KEY_PEPPER）MUST 通过环境变量或 Secret 注入，禁止把真实值提交到仓库。
# ============================================================

# ============ 应用 ============
APP_NAME=ai-platform
APP_ENV=local
DEBUG=true
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
# JSON 数组格式
CORS_ORIGINS=["*"]
# 基础设施后端：memory = 进程内实现（单实例开发/测试）；real = Redis/MySQL/Milvus/MinIO/Kafka
# 出厂默认 real：**TASK_RUNNER=kafka 强制要求 real**（Worker 是另一个进程，
# 内存里的任务表它看不见）。只想零依赖跑通接口就按「异步任务」段的开发档改回 memory。
INFRA_BACKEND=real

# ============ 鉴权与日志 ============
# 生产（APP_ENV=prod）下 AUTH_ENABLED 会被强制视为 true
AUTH_ENABLED=true
# Go 侧签发的 HS256 密钥（与 Go 侧共享）
JWT_SECRET=please-replace-me
JWT_ALGORITHM=HS256
JWT_ISSUER=ai-assistant
JWT_AUDIENCE=ai-platform
# AUTH_ENABLED=false 时使用的兜底用户（仅本地）
DEBUG_USER_ID=u_dev
LOG_LEVEL=INFO
# json（生产）/ console（本地）
LOG_FORMAT=json
# 日志中 user_id 做 HMAC-SHA256 用的 pepper
API_KEY_PEPPER=please-replace-me
# JSON 请求体上限（字节）；multipart 走高 UPLOAD_MAX_MB
MAX_JSON_BODY_BYTES=2097152

# ============ LLM（OpenAI 兼容协议，默认接 DeepSeek）============
# 申请地址：https://platform.deepseek.com/api_keys
OPENAI_API_KEY=sk-please-replace-me
# DeepSeek 的 OpenAI 兼容地址（结尾的 /v1 与模型版本无关，不能省略）
OPENAI_BASE_URL=https://api.deepseek.com/v1
# deepseek-flash = 主力对话模型；deepseek-v4-pro = 更高规格（更慢、更贵）
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.0
LLM_MAX_CONCURRENCY=8
LLM_TIMEOUT_SECONDS=60
LLM_FIRST_TOKEN_TIMEOUT_SECONDS=30
MAX_OUTPUT_TOKENS=2048
CONTEXT_TOKEN_BUDGET=8192
# 启动时发一次最小真实调用核对模型名（只告警不阻断）。生产建议 false（启动不该依赖外网）
LLM_VERIFY_MODEL_ON_STARTUP=false

# 如需切回官方 OpenAI：
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# ============ Embedding ============
# 四档（EMBEDDING_PROVIDER）：
#   siliconflow = 硅基流动**云端**（出厂档）—— 真批量 N 进 N 出，窗口 32768，不占本机算力
#   ark         = 火山方舟**云端**多模态 —— ⚠️ 一次请求只返回一条向量（见下方说明）
#   bge         = 本地 BGE 权重（需下载 ~2GB；CPU 上 1.45~2.06 ms/token，8MB 要 70~100min）
#   hash        = 确定性词法向量（零下载、跨进程确定 —— 测试与无网环境用）
EMBEDDING_PROVIDER=siliconflow
# 硅基流动的 embedding 端点（OpenAI 兼容）**支持真批量**：文档原文
#   「input: string | array —— 要在单次请求中处理多个输入，请传递字符串数组。」
# 实测：传 8/32/64/128 条都返回同数量且带 index；batch=32 × 并发 8 ⇒ **379.6 片/s**。
# 所以这里的实现是「分批 + 有限并发」，而不是 ark 档那种「每片一次 HTTP」。
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# 维度：0.6B 原生 **1024**（4B=2560、8B=4096）。启动期用 EMBEDDING_MODEL_DIMS 核对已知模型。
# MUST 与 MILVUS_VECTOR_DIM 一致，且**换模型必须换集合名或 drop 重建**
# （⚠️ 维度对齐 ≠ 向量空间能混用：1024 维的 bge-m3 与 1024 维的 Qwen3 不能混在一个集合里）。
EMBEDDING_DIM=1024
# 每次 HTTP 里放几条（真批量）。实测 batch=32 最优；48 条时中位延迟 1265ms、尾延迟变差。
EMBEDDING_BATCH_SIZE=32
# 入库时同时在飞的批次数 —— **云端档的吞吐关键**：每次调用都是一次网络往返，
# 串行等待等于只维持一个请求在飞。实测 8MB/5,821 片：串行 98.2s → 窗口 8 **40.4s**
# （窗口 16 = 40.9s，8 已是拐点）。本地 bge 档建议设 1。
INGEST_EMBED_WINDOW=8
EMBEDDING_CACHE_ENABLED=true

# 云端 Embedding / Rerank（硅基流动 SiliconFlow）
# 密钥只放 .env / Secret，禁止提交；申请：https://cloud.siliconflow.cn/account/ak
# 同一个 key 同时用于 /v1/embeddings 与 /v1/rerank。★ 换过 key 后请轮换旧的。
SILICONFLOW_API_KEY=sk-please-replace-me
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# 并发：实测（490 token 的块）batch=16/并发4 → 140 片/s；batch=32/并发4 → 206；
# **batch=32/并发8 → 379.6**；batch=48/并发8 → 289（尾延迟变差）。范围 [1,32]。
SILICONFLOW_EMBEDDING_CONCURRENCY=8
SILICONFLOW_EMBEDDING_TIMEOUT_SECONDS=60
# 单次请求的退避重试次数（只对 429/5xx/网络重试；400/401/403/404 立即失败）
SILICONFLOW_EMBEDDING_MAX_RETRIES=2
# base64 = float32 小端（实测单条 21,891B → 5,641B，**3.9×**；与 float 逐元素一致）
# float  = JSON 浮点数组（可读性好，调试时用）
SILICONFLOW_EMBEDDING_ENCODING=base64
# 降维（MRL）：0 = 原生维度（推荐）。Qwen3 系列可选档位：
#   0.6B: 64/128/256/512/768/1024   4B: …/2560   8B: …/4096
# 设成 N 时必须同时改 EMBEDDING_DIM / MILVUS_VECTOR_DIM **并换集合名**。
SILICONFLOW_EMBEDDING_DIMENSIONS=0

# ---- 云端档（EMBEDDING_PROVIDER=ark）才需要的配置 ----
# ⚠️ ark 档的语义（与 OpenAI 的 /embeddings 不同，实测确认）：
#   端点 /embeddings/multimodal 的 input 是**一个多模态输入**，**一次请求只返回一条向量**；
#   传 256 条文本仍只返回 1 条（usage.prompt_tokens=3493，说明它把多条聚合成一条）。
#   ⇒ 换到该档时本项目按"**每片一次 HTTP + 并发池**"实现（app/rag/embedding/ark.py）。
# 维度**随模型版本变**：-251215 → 2048；-250615 → 1024。
# ARK_API_KEY=ark-please-replace-me
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_EMBEDDING_CONCURRENCY=16        # 实测 1→4.4 / 8→31.6 / **32→98.9** / 64→99.5 req/s
# ARK_EMBEDDING_TIMEOUT_SECONDS=30
# ARK_EMBEDDING_MAX_RETRIES=2
# ARK_EMBEDDING_ENCODING=base64       # 34,240B → 11,219B（3.05×）
# ARK_EMBEDDING_DIMENSIONS=0          # 降维（与全维前 N 维余弦 0.9992；1024 可用、512 被拒）
# ARK_EMBEDDING_INSTRUCTIONS=

# ---- 本地档（EMBEDDING_PROVIDER=bge）才需要的配置 ----
# 候选档位（维度取自各模型 config.json 的 hidden_size，启动期会核对）：
#   BAAI/bge-m3             1024  多语言 + 长上下文
#   BAAI/bge-large-zh-v1.5  1024  中文专用；与 bge-m3 同维度 ⇒ 换它不用重建集合
#   BAAI/bge-base-zh-v1.5    768  中文，体积 / 质量折中
#   BAAI/bge-small-zh-v1.5   512  最快（4 层 / hidden 512）—— ⚠️ 其窗口也是 **512**，
#                                 而本项目的切分口径是 cl100k token（中文 ≈0.86 token/字），
#                                 在 BERT 词表下会**超过窗口被静默截断** ⇒ 必须调小 CHUNK_SIZE
# ⚠️ 换模型 = 改召回配方：同步 EMBEDDING_DIM / MILVUS_VECTOR_DIM，**换集合名或 drop 重建**
#    （启动期会拦维度不符），并重跑检索评测，否则「变快了」可能只是「查得更差了」。
# EMBEDDING_MODEL=BAAI/bge-m3
# cpu | cuda | cuda:0 | mps —— 有 GPU 时 cuda 是数量级提速（embedding 与 reranker 都受益）
# EMBEDDING_DEVICE=cpu

# ============ 本地推理运行时 ============
# CPU 推理的 torch 线程数上限。**只对本地档（bge embedding / bge reranker）生效；出厂档两个都走云端，因此它不影响任何东西**。
# **不写这一行 = 默认取逻辑核数的一半**（20 核 ⇒ 10，见 config.default_torch_num_threads）。
# 为什么不能沿用 torch 出厂默认（= 逻辑核数）：一次大文档的向量化会把整机的核吃满，
# 同机的 MySQL / Redis / 网关 / 验收脚本一起慢 2~3 倍 —— 实测连跑两遍全套
# M1 41s→75s、M2 71s→186s，现象看起来像「产品变慢了」（ai-platform-go/docs/09 §7.2）。
# 显式写 0 = 不干预（只推荐单机独占、不在意同机其它服务的场景）。
# ⚠️ 不要写空值（空串不是合法整数，会启动失败）；想固化就取消下面一行的注释：
# TORCH_NUM_THREADS=10

# ============ Reranker ============
# 两档（RERANKER_PROVIDER）：siliconflow = 云端 /v1/rerank（出厂档）；bge = 本地交叉编码器。
# 为什么出厂用云端：本地 bge-reranker-v2-m3 在 CPU 上 top_k=20 → top_n=5 实测 **70~83s**
# （ai-platform-go/docs/11-§6.6），而 Qwen/Qwen3-Reranker-0.6B 走云端只需 **320ms 左右**（同条件）。
# 关掉重排（RERANKER_ENABLED=false）会记 degraded_reasons=["rerank_skipped"]，走纯向量分数。
RERANKER_PROVIDER=siliconflow
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANKER_TOP_N=5
RERANKER_ENABLED=true
# 单次请求最多几条候选（超过就分片，各取 top_n 后全局归并）。文档未给上限，
# 实测 50/100/201 条都是 200，但 201 条耗时 2903ms ⇒ 默认压到 100 控尾延迟。
SILICONFLOW_RERANK_MAX_DOCUMENTS=100
SILICONFLOW_RERANK_TIMEOUT_SECONDS=30
SILICONFLOW_RERANK_MAX_RETRIES=1
# 重排指令（仅 Qwen3-Reranker 系列支持；留空则不发该参数）
SILICONFLOW_RERANK_INSTRUCTION=
# ---- 本地档（RERANKER_PROVIDER=bge）才需要 ----
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# RERANKER_DEVICE=cpu
# ⚠️ 该档需要 torch + FlagEmbedding + ~2.2GB 权重，且**必须自己量延迟**再上线。

# ============ Milvus ============
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_USER=root
MILVUS_PASSWORD=Milvus
MILVUS_DB_NAME=default
# ⚠️ 换 embedding 模型后**旧集合的向量不可用**，一律换新集合名（旧的保留作回滚）：
#   ai_platform_chunks                1024 / bge-m3（v1）
#   ai_platform_chunks_v2             2048 / doubao 多模态（v2）
#   ai_platform_chunks_v3             1024 / Qwen3-Embedding（v3，当前）
# ⚠️ v1 与 v3 都是 1024 维，但**向量空间完全不同，不能混写/混查**。
MILVUS_COLLECTION=ai_platform_chunks_v3
MILVUS_MEMORY_COLLECTION=ai_platform_memories_v3
# MUST 与 EMBEDDING_DIM 一致；启动期与"已存在集合的实际维度"双向核对（都差 1 维就拦）
MILVUS_VECTOR_DIM=1024
MILVUS_SEARCH_EF=64

# ============ MySQL / Redis / MinIO / Kafka（INFRA_BACKEND=real 时必填）============
# 可选依赖（装哪些取决于下面填了哪些）：
#   uv sync --extra mysql --extra minio --extra redis --extra kafka
# MySQL：先建表（一次性）
#   mysql --default-character-set=utf8mb4 -u root -p -e "source ai-platform/deploy/mysql/001_init_schema.sql"
#   老库补列：002_align_shared_tables.sql / 003_add_chunk_metadata.sql
#   自检：mysql ... -e "source ai-platform/deploy/mysql/verify_schema.sql"
MYSQL_DSN=mysql+asyncmy://root:pass@localhost:3306/ai_platform
# MinIO：由 deploy/infra/compose.yml 的 minio 服务提供（API :9000，控制台 :9011）。
# 下面两个凭据必须与 compose 里的 MINIO_ROOT_USER/PASSWORD 一致；
# 空值会让上传直接报凭据错误（S3 的 SignatureDoesNotMatch），不是 403 业务错误。
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ai-platform
MINIO_SECURE=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=ai-platform-worker

# ============ RAG / 入库 ============
RETRIEVAL_TOP_K=20
SCORE_THRESHOLD=0.0
RAG_CONTEXT_TOKEN_BUDGET=2500
RAG_MERGE_ADJACENT_CHUNKS=true
UPLOAD_MAX_MB=50
MIN_DOC_CHARS=50
MAX_DOC_PAGES=500
MAX_DOC_CHUNKS=10000
MAX_KB_DOCUMENTS=1000
MAX_KB_COUNT=50
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ============ Agent / Tool / MCP ============
AGENT_MAX_STEPS=8
AGENT_TIMEOUT_SECONDS=120
TOOL_TIMEOUT_SECONDS=10
TOOL_RESULT_MAX_CHARS=4000
TOOL_HTTP_FETCH_ENABLED=false
TOOL_WRITE_ALLOWLIST=["memory_save"]
MCP_STARTUP_TIMEOUT_SECONDS=15
# MCP（可选，JSON 对象；字段表见 docs/05-§2.2）
#   transport          stdio（默认）| streamable_http
#   required=true      启动时连不上 → 应用拒绝启动（AC-MCP-02）
#   tools_allowlist    null = 全部放开；denylist 优先于 allowlist
#   write_tools        子集内的工具才算「写操作」（会走审计日志 + TOOL_WRITE_ALLOWLIST 闸门）
#   ${VAR} 语法可引用环境变量，但只允许白名单内的键（密钥走 secret 引用，不写明文）
# MCP_SERVERS={"filesystem":{"command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","."]}}
# MCP_SERVERS={"echo":{"transport":"streamable_http","url":"http://localhost:8931/mcp","headers":{"Authorization":"${MCP_TOKEN}"},"required":false,"timeout_seconds":30,"tools_allowlist":["echo"],"write_tools":[]}}

# ============ Memory ============
MEMORY_TTL_DAYS=7
MEMORY_MAX_MESSAGES=200
MEMORY_RECENT_TURNS=10
HISTORY_TOKEN_BUDGET=2400
MEMORY_TOKEN_BUDGET=600
MEMORY_TOP_N=3
MEMORY_MIN_CONFIDENCE=0.7
MEMORY_DEDUPE_THRESHOLD=0.92
MEMORY_SCORE_THRESHOLD=0.45
SUMMARY_TOKEN_BUDGET=1200
SUMMARY_KEEP_RECENT_TURNS=10
SUMMARY_MIN_NEW_MESSAGES=20
SUMMARY_TRIGGER_RATIO=0.8
SYSTEM_PROMPT_TOKEN_BUDGET=1000

# ============ 异步任务 / 可观测 ============
# 任务执行器（谁在跑 task，docs/08）：
#   kafka  投递到 Kafka，由**独立 Worker 进程**消费 —— **出厂默认**，生产/验收形态。
#          ingest 的解析 / 切分 / 向量化完全不进 API 进程，大文件不会拖垮在线请求。
#          需要：uv sync --extra kafka --extra redis；起 Kafka；另开终端跑
#                `uv run python -m app.worker`（见 README 快速开始）。
#   inline 应用内联执行（单进程开发）。**大文件会占住 API 的事件循环与 CPU** ——
#          实测 8MB 文档的解析/切分/哈希/向量化期间，同机所有请求一起变慢。
#   none   只建任务不执行（测试断言「202 之后什么也没发生」）。
TASK_RUNNER=kafka
# 任务与事件存储后端见「应用」段的 INFRA_BACKEND（**同一个键只声明一次**，避免两处不一致）：
#   kafka 要求 real —— Worker 是另一个进程，内存里的任务表它看不见。
# —— 单进程开发档（零外部依赖，代价是大文件会拖垮在线请求）——
#   把 TASK_RUNNER 改成 inline、把「应用」段的 INFRA_BACKEND 改成 memory，
#   这样 `uv run uvicorn app.main:app` 不需要 Redis / Kafka / MySQL / Milvus / MinIO。
WORKER_CONCURRENCY=2
# Embedding 与其它阶段的并发闸门：它最吃内存，单独限流（1 = 串行）
WORKER_EMBED_CONCURRENCY=1
TASK_TIMEOUT_SECONDS=1800
TASK_MAX_RETRIES=3
INGEST_QUEUE_MAX=1000
# 自动重试退避：delay = base * 4 ** (attempt-1)，再叠加 ±TASK_RETRY_JITTER 抖动
# 退避期间不占 Worker 额度（到期时间存 Redis ZSET，由 Worker 顺路捞取）
TASK_RETRY_BASE_SECONDS=1.0
TASK_RETRY_JITTER=0.2
TASK_RETRY_POLL_SECONDS=1.0
# 补偿扫描（docs/08-§5.1）：定期把「投递丢了」的滞留 PENDING 重新投出去
TASK_COMPENSATION_INTERVAL_SECONDS=30
TASK_COMPENSATION_GRACE_SECONDS=60
TASK_COMPENSATION_MAX_ATTEMPTS=3
# 滞留超过这个时长仍未投递成功 → 直接判失败（避免永远转圈的 PENDING）
TASK_PENDING_MAX_AGE_SECONDS=600
# 收到停止信号后等任务收尾的时长；超时按取消处理
TASK_SHUTDOWN_GRACE_SECONDS=30

# ============ Redis / Kafka（INFRA_BACKEND=real 或 TASK_RUNNER=kafka 时必填）============
# 需要可选依赖：uv sync --extra redis / uv sync --extra kafka
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=ai-platform-worker

# ============ 可观测 ============
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=ai-platform
# 采样率 0~1；本地调试想看全量链路就设 1.0
OTEL_TRACES_SAMPLER_ARG=0.1
# Prometheus 抓取端点：GET http://<host>:<METRICS_PORT>/metrics
# METRICS_PORT=0 表示由操作系统随机分配端口（测试/多实例时用得上）
METRICS_ENABLED=true
METRICS_PORT=9100
METRICS_HOST=0.0.0.0

# ============ 国内下载 HuggingFace 模型加速（可选）============
# 应用启动时会把该值同步进 os.environ 后再构造模型 —— huggingface_hub 只读
# 进程环境变量、不读 .env，所以不写这一行时「配了镜像但仍在连 huggingface.co」
# 是静默失效的（表现为首次重排卡到超时后降级 rerank_applied=false）。
# 真实环境变量优先级更高（容器编排注入的同名变量会覆盖这里的值）。
# 若模型已全部预下载进 HF 缓存，也可改用 HF_HUB_OFFLINE=1 彻底跳过联网校验。
# HF_ENDPOINT=https://hf-mirror.com
